  id,
  learning_path_id,
  title,
  description,
  content_type,
  content,
  duration_minutes,
  order_index,
  learning_objectives
) VALUES (
  gen_random_uuid(),
  'f8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c',
  'UI Interactions & Form Handling',
  'Master form inputs, mouse actions, keyboard events, and file uploads',
  'article',
  E'# UI Interactions & Form Handling

## Form Handling Mastery

Forms are everywhere in web apps. Let''s master all form interactions!

### Text Inputs

```typescript
// Fill input (clears first, then types)
await page.getByLabel(''Email'').fill(''user@example.com'');

// Type (doesn''t clear, just adds text)
await page.getByLabel(''Comment'').type(''Additional info'');

// Clear input
await page.getByLabel(''Email'').clear();

// Fill and press Enter
await page.getByLabel(''Search'').fill(''Playwright'');
await page.getByLabel(''Search'').press(''Enter'');

// Type slowly (character by character)
await page.getByLabel(''Code'').pressSequentially(''ABC123'', { delay: 100 });
```

### Checkboxes

```typescript
// Check a checkbox
await page.getByLabel(''I agree to terms'').check();

// Uncheck
await page.getByLabel(''Newsletter'').uncheck();

// Toggle (check if unchecked, uncheck if checked)
await page.getByLabel(''Dark mode'').click();

// Set to specific state
await page.getByLabel(''Remember me'').setChecked(true);
await page.getByLabel(''Remember me'').setChecked(false);

// Assert checkbox state
await expect(page.getByLabel(''I agree'')).toBeChecked();
await expect(page.getByLabel(''I agree'')).not.toBeChecked();
```

### Radio Buttons

```typescript
// Select radio button
await page.getByLabel(''Male'').check();
await page.getByLabel(''Female'').check();

// Radio buttons by value
await page.locator(''input[type="radio"][value="monthly"]'').check();

// Assert which is selected
await expect(page.getByLabel(''Monthly'')).toBeChecked();
await expect(page.getByLabel(''Yearly'')).not.toBeChecked();
```

### Dropdowns (Select Elements)

```typescript
// Select by label (visible text)
await page.getByLabel(''Country'').selectOption(''United States'');

// Select by value
await page.locator(''select[name="plan"]'').selectOption({ value: ''premium'' });

// Select by index
await page.locator(''select'').selectOption({ index: 2 });

// Select multiple options
await page.getByLabel(''Skills'').selectOption([''JavaScript'', ''TypeScript'', ''React'']);

// Get selected value
const value = await page.locator(''select'').inputValue();
console.log(''Selected:'', value);

// Assert selected option
await expect(page.getByLabel(''Country'')).toHaveValue(''US'');
```

:::practice language=typescript | height=450px | title=Complete Form Example
import { test, expect } from ''@playwright/test'';

test(''fill registration form'', async ({ page }) => {
  await page.goto(''https://example.com/register'');

  // Text inputs
  await page.getByLabel(''First Name'').fill(''John'');
  await page.getByLabel(''Last Name'').fill(''Doe'');
  await page.getByLabel(''Email'').fill(''john@example.com'');

  // Password
  await page.getByLabel(''Password'').fill(''SecurePass123!'');
  await page.getByLabel(''Confirm Password'').fill(''SecurePass123!'');

  // Radio button
  await page.getByLabel(''Male'').check();

  // Checkboxes
  await page.getByLabel(''I agree to terms'').check();
  await page.getByLabel(''Subscribe to newsletter'').check();

  // Dropdown
  await page.getByLabel(''Country'').selectOption(''United States'');

  // Submit
  await page.getByRole(''button'', { name: ''Register'' }).click();

  // Verify success
  await expect(page.getByText(''Registration successful'')).toBeVisible();
});
:::

## File Uploads

### Single File Upload

```typescript
// Upload a file
await page.getByLabel(''Upload file'').setInputFiles(''path/to/file.pdf'');

// Upload from buffer
const buffer = Buffer.from(''file content'');
await page.getByLabel(''Upload'').setInputFiles({
  name: ''file.txt'',
  mimeType: ''text/plain'',
  buffer: buffer
});

// Remove uploaded file
await page.getByLabel(''Upload file'').setInputFiles([]);
```

### Multiple File Uploads

```typescript
// Upload multiple files
await page.getByLabel(''Upload files'').setInputFiles([
  ''path/to/file1.pdf'',
  ''path/to/file2.jpg'',
  ''path/to/file3.png''
]);
```

### File Upload with Dialog

```typescript
// Wait for file chooser event
const fileChooserPromise = page.waitForEvent(''filechooser'');
await page.getByText(''Choose file'').click();
const fileChooser = await fileChooserPromise;
await fileChooser.setFiles(''path/to/file.pdf'');
```

## Mouse Actions

### Hover (Mouse Over)

```typescript
// Simple hover
await page.getByRole(''button'', { name: ''Menu'' }).hover();

// Hover and wait for tooltip
await page.locator(''.info-icon'').hover();
await expect(page.locator(''.tooltip'')).toBeVisible();

// Hover with position
await page.locator(''.canvas'').hover({ position: { x: 100, y: 200 } });
```

### Click Variations

```typescript
// Regular click
await page.getByRole(''button'').click();

// Double click
await page.locator(''.file-name'').dblclick();

// Right click (context menu)
await page.locator(''.item'').click({ button: ''right'' });

// Click with modifiers
await page.getByRole(''link'').click({ modifiers: [''Control''] }); // Ctrl+Click
await page.getByRole(''link'').click({ modifiers: [''Meta''] });    // Cmd+Click (Mac)
await page.getByRole(''link'').click({ modifiers: [''Shift''] });   // Shift+Click

// Click at specific position
await page.locator(''.map'').click({ position: { x: 150, y: 200 } });

// Force click (bypass actionability checks)
await page.locator(''button'').click({ force: true });

// Click with delay
await page.getByRole(''button'').click({ delay: 100 });
```

### Drag and Drop

```typescript
// Drag and drop
await page.locator(''.draggable'').dragTo(page.locator(''.drop-zone''));

// Drag with precise control
await page.locator(''.item'').hover();
await page.mouse.down();
await page.locator(''.target'').hover();
await page.mouse.up();

// Drag by offset
await page.locator(''.slider'').dragTo(page.locator(''.slider''), {
  targetPosition: { x: 200, y: 0 }
});
```

:::practice language=typescript | height=400px | title=Practice Mouse Actions
import { test, expect } from ''@playwright/test'';

test(''mouse interactions'', async ({ page }) => {
  await page.goto(''https://example.com'');

  // Hover to reveal submenu
  await page.getByRole(''link'', { name: ''Products'' }).hover();
  await expect(page.locator(''.submenu'')).toBeVisible();

  // Right click
  await page.locator(''.file'').click({ button: ''right'' });
  await expect(page.locator(''.context-menu'')).toBeVisible();

  // Double click to select text
  await page.locator(''p'').first().dblclick();

  // Drag and drop
  await page.locator(''.task'').first().dragTo(page.locator(''.completed''));

  // Ctrl+Click to open in new tab
  const [newPage] = await Promise.all([
    page.context().waitForEvent(''page''),
    page.getByRole(''link'').click({ modifiers: [''Control''] })
  ]);
  await expect(newPage).toHaveURL(/.*about.*/);
});
:::

## Keyboard Actions

### Press Keys

```typescript
// Press single key
await page.keyboard.press(''Enter'');
await page.keyboard.press(''Tab'');
await page.keyboard.press(''Escape'');
await page.keyboard.press(''ArrowDown'');

// Press with input focused
await page.getByLabel(''Search'').press(''Enter'');
await page.getByLabel(''Code'').press(''Tab'');

// Press multiple keys (shortcut)
await page.keyboard.press(''Control+A''); // Select all
await page.keyboard.press(''Control+C''); // Copy
await page.keyboard.press(''Control+V''); // Paste
await page.keyboard.press(''Meta+S'');    // Cmd/Win + S (Save)
```

### Type Text

```typescript
// Type normally (fast)
await page.keyboard.type(''Hello World'');

// Type slowly (with delay)
await page.keyboard.type(''Slow typing'', { delay: 100 });

// Press sequentially (character by character)
await page.getByLabel(''OTP'').pressSequentially(''123456'', { delay: 50 });
```

### Hold Keys

```typescript
// Hold Shift and click multiple items
await page.keyboard.down(''Shift'');
await page.locator(''.item'').nth(0).click();
await page.locator(''.item'').nth(3).click();
await page.keyboard.up(''Shift'');

// Ctrl+A (select all)
await page.keyboard.down(''Control'');
await page.keyboard.press(''A'');
await page.keyboard.up(''Control'');
```

## Common UI Patterns

### Toggle Switches

```typescript
// Click to toggle
await page.locator(''.toggle-switch'').click();

// Set to specific state
const isOn = await page.locator(''.toggle-switch'').isChecked();
if (!isOn) {
  await page.locator(''.toggle-switch'').click();
}
```

### Sliders

```typescript
// Slide by dragging
await page.locator(''.slider-handle'').dragTo(page.locator(''.slider-handle''), {
  targetPosition: { x: 200, y: 0 }
});

// Set value if slider has input
await page.locator(''input[type="range"]'').fill(''75'');
```

### Color Pickers

```typescript
// Set color value
await page.locator(''input[type="color"]'').fill(''#ff0000'');

// Get color value
const color = await page.locator(''input[type="color"]'').inputValue();
console.log(''Selected color:'', color);
```

### Date Pickers

```typescript
// Fill date input
await page.locator(''input[type="date"]'').fill(''2024-12-31'');

// Click calendar and select date
await page.getByLabel(''Date of Birth'').click();
await page.locator(''.calendar-day[data-date="15"]'').click();
```

## Summary

**What you learned:**
- ✅ Complete form handling: inputs, checkboxes, radio, dropdowns
- ✅ File uploads (single and multiple)
- ✅ Mouse actions: hover, click variations, drag & drop
- ✅ Keyboard shortcuts and key combinations
- ✅ Common UI patterns: toggles, sliders, date pickers

**Next lesson:** Handle dialogs, alerts, iframes, and complex scenarios!

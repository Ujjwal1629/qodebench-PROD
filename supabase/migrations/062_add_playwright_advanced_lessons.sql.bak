  gen_random_uuid(),
  'f8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c',
  'Advanced Locators & Powerful Assertions',
  'Master CSS, XPath, and advanced locator strategies with comprehensive assertions',
  'article',
  E'# Advanced Locators & Powerful Assertions

## Locator Strategies Overview

In the last lesson, we learned about `getByRole`, `getByLabel`, etc. Now let''s explore **all locator strategies** Playwright offers.

### Quick Reference: All Locator Types

```typescript
// 1. Recommended (Semantic)
page.getByRole(''button'', { name: ''Submit'' })
page.getByLabel(''Email'')
page.getByPlaceholder(''Enter your name'')
page.getByText(''Welcome back'')
page.getByAltText(''Profile picture'')
page.getByTitle(''Close window'')

// 2. Stable IDs
page.getByTestId(''submit-btn'')

// 3. CSS Selectors
page.locator(''.submit-button'')
page.locator(''#user-email'')
page.locator(''div > button.primary'')

// 4. XPath (last resort)
page.locator(''//button[contains(@class, "submit")]'')
```

## CSS Selectors Deep Dive

CSS selectors are powerful for targeting elements:

### Basic CSS Selectors

```typescript
// By class
await page.locator(''.button'').click();

// By ID
await page.locator(''#submit-btn'').click();

// By attribute
await page.locator(''[data-test="login-btn"]'').click();
await page.locator(''[type="email"]'').fill(''user@example.com'');

// By tag name
await page.locator(''button'').click();

// Combining selectors
await page.locator(''button.primary.large'').click();
await page.locator(''input[type="email"]#user-email'').fill(''...'');
```

### Advanced CSS Selectors

```typescript
// Child selector (direct child)
await page.locator(''div > button'').click();

// Descendant selector (any nested child)
await page.locator(''form button'').click();

// Attribute contains
await page.locator(''[class*="submit"]'').click(); // class contains "submit"

// Attribute starts with
await page.locator(''[id^="user-"]'').click(); // id starts with "user-"

// Attribute ends with
await page.locator(''[class$="-button"]'').click(); // class ends with "-button"

// Multiple attributes
await page.locator(''input[type="text"][required]'').fill(''...'');

// nth-child
await page.locator(''li:nth-child(2)'').click(); // Second list item
await page.locator(''li:first-child'').click();  // First
await page.locator(''li:last-child'').click();   // Last
```

:::practice language=typescript | height=350px | title=Practice CSS Selectors
import { test, expect } from ''@playwright/test'';

test(''CSS selector examples'', async ({ page }) => {
  await page.goto(''https://example.com'');

  // Class selector
  await page.locator(''.nav-link'').first().click();

  // ID selector
  await page.locator(''#search-input'').fill(''Playwright'');

  // Attribute selector
  await page.locator(''[data-testid="submit"]'').click();

  // Combined selectors
  await page.locator(''button.primary[type="submit"]'').click();

  // Descendant
  await page.locator(''form input[name="email"]'').fill(''test@example.com'');

  // nth-child
  await page.locator(''ul.menu > li:nth-child(3)'').click();
});
:::

## XPath Selectors

XPath is powerful but should be your **last resort** (fragile and slower).

### When to Use XPath

✅ **Use XPath when:**
- You need to navigate based on text content in complex structures
- You need to select based on parent elements
- CSS selectors become too complex

❌ **Avoid XPath for:**
- Simple element selection (use CSS instead)
- Performance-critical tests

### Basic XPath Examples

```typescript
// By text content
await page.locator(''//button[text()="Submit"]'').click();

// Contains text
await page.locator(''//button[contains(text(), "Save")]'').click();

// By attribute
await page.locator(''//input[@type="email"]'').fill(''...'');

// By ID
await page.locator(''//*[@id="submit-btn"]'').click();

// By class (contains)
await page.locator(''//button[contains(@class, "primary")]'').click();

// Parent selection (powerful!)
await page.locator(''//label[text()="Email"]/following-sibling::input'').fill(''...'');

// Ancestor selection
await page.locator(''//button[@id="save"]//ancestor::form'');
```

:::warning XPath Performance
XPath is slower than CSS selectors. Use CSS or getBy methods when possible!
:::

## Advanced Locator Methods

Playwright provides powerful filtering methods:

### has() - Filter by Descendant

Find elements that **contain** specific child elements:

```typescript
// Find a product card that has a "Sale" badge
await page.locator(''.product-card'').filter({
  has: page.locator(''.sale-badge'')
}).click();

// Find a row that contains specific text
await page.locator(''tr'').filter({
  has: page.locator(''text="Active"'')
}).click();
```

### hasText() - Filter by Text Content

Find elements containing specific text:

```typescript
// Find button with specific text
await page.getByRole(''button'').filter({ hasText: ''Delete'' }).click();

// Find card containing "Premium"
await page.locator(''.card'').filter({ hasText: ''Premium'' }).click();

// Case-insensitive text match
await page.locator(''div'').filter({ hasText: /premium/i }).click();
```

### hasNot() - Negative Filter

Find elements that **do not** contain something:

```typescript
// Find rows that don''t have a "Completed" status
await page.locator(''tr'').filter({
  hasNot: page.locator(''text="Completed"'')
}).click();

// Find buttons that don''t contain "Cancel"
await page.getByRole(''button'').filter({
  hasNot: page.getByText(''Cancel'')
}).click();
```

### Chaining Filters

You can chain multiple filters:

```typescript
await page
  .locator(''.product-card'')
  .filter({ hasText: ''Electronics'' })
  .filter({ has: page.locator(''.in-stock'') })
  .filter({ hasNot: page.locator(''.sold-out'') })
  .first()
  .click();
```

:::practice language=typescript | height=400px | title=Practice Advanced Locators
import { test, expect } from ''@playwright/test'';

test(''advanced locator methods'', async ({ page }) => {
  await page.goto(''https://example.com/products'');

  // Find product with "Sale" badge
  const saleProduct = page.locator(''.product'').filter({
    has: page.locator(''.sale-badge'')
  });
  await saleProduct.first().click();

  // Find row with "Active" status
  const activeRow = page.locator(''tr'').filter({
    hasText: ''Active''
  });
  await expect(activeRow).toBeVisible();

  // Find buttons without "disabled" class
  const enabledButtons = page.getByRole(''button'').filter({
    hasNot: page.locator(''.disabled'')
  });
  await enabledButtons.first().click();

  // Complex chaining
  await page
    .locator(''.item'')
    .filter({ hasText: ''Available'' })
    .filter({ has: page.locator(''.in-stock'') })
    .nth(2)
    .click();
});
:::

## Comprehensive Assertions

Playwright provides many assertion methods via `expect()`:

### Element State Assertions

```typescript
// Visibility
await expect(page.locator(''h1'')).toBeVisible();
await expect(page.locator(''.loading'')).toBeHidden();
await expect(page.locator(''.modal'')).not.toBeVisible();

// Enabled/Disabled
await expect(page.getByRole(''button'')).toBeEnabled();
await expect(page.getByRole(''button'')).toBeDisabled();

// Checked (checkboxes/radio)
await expect(page.getByLabel(''I agree'')).toBeChecked();
await expect(page.getByLabel(''I agree'')).not.toBeChecked();

// Focused
await expect(page.getByLabel(''Email'')).toBeFocused();

// Editable
await expect(page.locator(''input'')).toBeEditable();
await expect(page.locator(''input'')).not.toBeEditable();

// Empty
await expect(page.locator(''input'')).toBeEmpty();
await expect(page.locator(''input'')).not.toBeEmpty();
```

### Text Content Assertions

```typescript
// Exact text match
await expect(page.locator(''h1'')).toHaveText(''Welcome'');

// Contains text
await expect(page.locator(''.message'')).toContainText(''Success'');

// Multiple elements text
await expect(page.locator(''li'')).toHaveText([''Item 1'', ''Item 2'', ''Item 3'']);

// Regex match
await expect(page.locator(''p'')).toHaveText(/hello.*world/i);

// Not equal
await expect(page.locator(''h1'')).not.toHaveText(''Error'');
```

### Attribute & Value Assertions

```typescript
// Attribute value
await expect(page.locator(''input'')).toHaveAttribute(''type'', ''email'');
await expect(page.locator(''a'')).toHaveAttribute(''href'', ''/about'');

// Attribute contains
await expect(page.locator(''img'')).toHaveAttribute(''src'', /logo\\.png/);

// Input value
await expect(page.locator(''input'')).toHaveValue(''test@example.com'');

// CSS class
await expect(page.locator(''button'')).toHaveClass(''btn-primary'');
await expect(page.locator(''button'')).toHaveClass(/btn-/);

// CSS property
await expect(page.locator(''h1'')).toHaveCSS(''color'', ''rgb(0, 0, 0)'');
await expect(page.locator(''div'')).toHaveCSS(''display'', ''flex'');
```

### Count & Collection Assertions

```typescript
// Count elements
await expect(page.locator(''li'')).toHaveCount(5);
await expect(page.locator(''.item'')).toHaveCount(10);

// At least one element
await expect(page.locator(''.product'')).not.toHaveCount(0);
```

### Page-Level Assertions

```typescript
// URL
await expect(page).toHaveURL(''https://example.com/dashboard'');
await expect(page).toHaveURL(/.*dashboard.*/);

// Title
await expect(page).toHaveTitle(''Dashboard - MyApp'');
await expect(page).toHaveTitle(/Dashboard/);

// Screenshot comparison (visual testing)
await expect(page).toHaveScreenshot(''homepage.png'');
```

### Custom Timeout for Assertions

```typescript
// Wait up to 10 seconds
await expect(page.locator(''.slow-element'')).toBeVisible({ timeout: 10000 });

// Quick check (1 second)
await expect(page.locator(''.fast-element'')).toBeVisible({ timeout: 1000 });
```

:::practice language=typescript | height=450px | title=Practice Assertions
import { test, expect } from ''@playwright/test'';

test(''comprehensive assertions'', async ({ page }) => {
  await page.goto(''https://example.com/login'');

  // Visibility
  await expect(page.getByRole(''heading'')).toBeVisible();
  await expect(page.locator(''.error-message'')).toBeHidden();

  // Input value
  await page.getByLabel(''Email'').fill(''test@example.com'');
  await expect(page.getByLabel(''Email'')).toHaveValue(''test@example.com'');

  // Attributes
  await expect(page.getByRole(''button'')).toHaveAttribute(''type'', ''submit'');
  await expect(page.getByRole(''button'')).toBeEnabled();

  // Text content
  await expect(page.locator(''h1'')).toHaveText(''Sign In'');
  await expect(page.locator(''.welcome'')).toContainText(''Welcome'');

  // Count
  await expect(page.locator(''input'')).toHaveCount(2);

  // URL and Title
  await expect(page).toHaveURL(/.*login.*/);
  await expect(page).toHaveTitle(/Login/);

  // CSS
  await expect(page.locator(''button'')).toHaveClass(/btn-primary/);
});
:::

## Best Practices Summary

### Locator Priority (Best to Worst)

1. ✅ **getByRole** - Accessibility-first
2. ✅ **getByLabel** - Form elements
3. ✅ **getByPlaceholder** - Inputs with placeholders
4. ✅ **getByText** - Unique text content
5. ✅ **getByTestId** - Stable test IDs
6. ⚠️ **CSS Selectors** - When above don''t work
7. ❌ **XPath** - Last resort only

### Assertion Best Practices

- ✅ Use specific assertions (`toBeVisible` vs `toBeTruthy`)
- ✅ Assert multiple properties when needed
- ✅ Use custom timeouts for slow operations
- ✅ Avoid hard-coded waits (`page.waitForTimeout`)
- ✅ Let Playwright auto-wait with assertions

### Common Mistakes to Avoid

```typescript
// ❌ Bad: Too fragile
await page.locator(''div > div > span.text'').click();

// ✅ Good: Semantic and stable
await page.getByRole(''button'', { name: ''Submit'' }).click();

// ❌ Bad: Hard-coded wait
await page.waitForTimeout(5000);
await page.locator(''.result'').click();

// ✅ Good: Smart waiting with assertion
await expect(page.locator(''.result'')).toBeVisible();
await page.locator(''.result'').click();
```

## Summary

**What you learned:**
- ✅ All locator strategies: CSS, XPath, getBy methods
- ✅ Advanced filtering: has(), hasText(), hasNot()
- ✅ Chaining filters for complex scenarios
- ✅ Comprehensive assertions for every use case
- ✅ Best practices for stable, maintainable tests

**Next lesson:** Master UI interactions including forms, mouse actions, and file uploads!
',
  45,
  3,
  ARRAY[
    'Master CSS and XPath selector strategies',
    'Use advanced locator methods (has, hasText, hasNot)',
    'Apply comprehensive assertions with expect()',
    'Follow locator best practices for stable tests'

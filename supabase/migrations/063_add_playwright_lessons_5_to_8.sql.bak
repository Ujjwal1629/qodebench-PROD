  'article',
  E'# Page Object Model & Scalable Test Architecture

## What is Page Object Model?

**Page Object Model (POM)** is a design pattern where each page/component has its own class containing locators and methods.

### Without POM (Bad)

```typescript
// login.spec.ts
test(''login as admin'', async ({ page }) => {
  await page.goto(''https://example.com/login'');
  await page.getByLabel(''Email'').fill(''admin@example.com'');
  await page.getByLabel(''Password'').fill(''admin123'');
  await page.getByRole(''button'', { name: ''Sign In'' }).click();
});

// profile.spec.ts - Duplicated login code!
test(''view profile'', async ({ page }) => {
  await page.goto(''https://example.com/login'');
  await page.getByLabel(''Email'').fill(''admin@example.com'');
  await page.getByLabel(''Password'').fill(''admin123'');
  await page.getByRole(''button'', { name: ''Sign In'' }).click();
  // ... rest of test
});
```

**Problems:**
- ❌ Code duplication
- ❌ Hard to maintain (if login form changes, update everywhere)
- ❌ Not reusable

### With POM (Good)

```typescript
// pages/login.page.ts
export class LoginPage {
  constructor(private page: Page) {}

  async goto() {
    await this.page.goto(''https://example.com/login'');
  }

  async login(email: string, password: string) {
    await this.page.getByLabel(''Email'').fill(email);
    await this.page.getByLabel(''Password'').fill(password);
    await this.page.getByRole(''button'', { name: ''Sign In'' }).click();
  }
}

// tests/login.spec.ts
test(''login as admin'', async ({ page }) => {
  const loginPage = new LoginPage(page);
  await loginPage.goto();
  await loginPage.login(''admin@example.com'', ''admin123'');
});
```

**Benefits:**
- ✅ Reusable code
- ✅ Easy to maintain
- ✅ Clean test code

## Building Your First Page Object

Let''s create a Login Page Object step by step.

### Basic Page Object

```typescript
// pages/login.page.ts
import { Page, Locator } from ''@playwright/test'';

export class LoginPage {
  readonly page: Page;
  readonly emailInput: Locator;
  readonly passwordInput: Locator;
  readonly submitButton: Locator;
  readonly errorMessage: Locator;

  constructor(page: Page) {
    this.page = page;
    this.emailInput = page.getByLabel(''Email'');
    this.passwordInput = page.getByLabel(''Password'');
    this.submitButton = page.getByRole(''button'', { name: ''Sign In'' });
    this.errorMessage = page.locator(''.error-message'');
  }

  async goto() {
    await this.page.goto(''https://example.com/login'');
  }

  async login(email: string, password: string) {
    await this.emailInput.fill(email);
    await this.passwordInput.fill(password);
    await this.submitButton.click();
  }

  async getErrorMessage() {
    return await this.errorMessage.textContent();
  }
}
```

### Using the Page Object

```typescript
import { test, expect } from ''@playwright/test'';
import { LoginPage } from ''../pages/login.page'';

test(''successful login'', async ({ page }) => {
  const loginPage = new LoginPage(page);

  await loginPage.goto();
  await loginPage.login(''user@example.com'', ''password123'');

  await expect(page).toHaveURL(/.*dashboard.*/);
});

test(''login with invalid credentials'', async ({ page }) => {
  const loginPage = new LoginPage(page);

  await loginPage.goto();
  await loginPage.login(''invalid@example.com'', ''wrong'');

  const error = await loginPage.getErrorMessage();
  expect(error).toContain(''Invalid credentials'');
});
```

## Advanced Page Object Patterns

### Method Chaining

```typescript
export class LoginPage {
  // ... locators

  async goto() {
    await this.page.goto(''https://example.com/login'');
    return this; // Return this for chaining
  }

  async fillEmail(email: string) {
    await this.emailInput.fill(email);
    return this;
  }

  async fillPassword(password: string) {
    await this.passwordInput.fill(password);
    return this;
  }

  async submit() {
    await this.submitButton.click();
    return this;
  }
}

// Usage with chaining
await loginPage
  .goto()
  .fillEmail(''user@example.com'')
  .fillPassword(''pass123'')
  .submit();
```

### Page Navigation

```typescript
export class LoginPage {
  // ... existing code

  async loginAs(email: string, password: string) {
    await this.login(email, password);
    return new DashboardPage(this.page); // Return next page
  }
}

// Usage
const dashboardPage = await loginPage.loginAs(''user@example.com'', ''pass123'');
await dashboardPage.verifyWelcomeMessage();
```

### Component Objects

For reusable components like navigation, header, footer:

```typescript
// components/navbar.component.ts
export class NavbarComponent {
  constructor(private page: Page) {}

  async clickProfile() {
    await this.page.getByRole(''button'', { name: ''Profile'' }).click();
  }

  async clickLogout() {
    await this.page.getByRole(''button'', { name: ''Logout'' }).click();
  }

  async searchFor(query: string) {
    await this.page.getByPlaceholder(''Search'').fill(query);
    await this.page.getByPlaceholder(''Search'').press(''Enter'');
  }
}

// pages/dashboard.page.ts
export class DashboardPage {
  readonly navbar: NavbarComponent;

  constructor(private page: Page) {
    this.navbar = new NavbarComponent(page);
  }

  // Dashboard-specific methods
}

// Usage
await dashboardPage.navbar.searchFor(''Playwright'');
await dashboardPage.navbar.clickLogout();
```

## Complete Example: E-Commerce Pages

```typescript
// pages/product-list.page.ts
export class ProductListPage {
  constructor(private page: Page) {}

  async goto() {
    await this.page.goto(''https://example.com/products'');
  }

  async searchProduct(name: string) {
    await this.page.getByPlaceholder(''Search products'').fill(name);
    await this.page.keyboard.press(''Enter'');
  }

  async selectProduct(name: string) {
    await this.page.getByRole(''link'', { name }).click();
    return new ProductDetailPage(this.page);
  }

  async getProductCount() {
    return await this.page.locator(''.product-card'').count();
  }
}

// pages/product-detail.page.ts
export class ProductDetailPage {
  constructor(private page: Page) {}

  async addToCart() {
    await this.page.getByRole(''button'', { name: ''Add to Cart'' }).click();
  }

  async selectSize(size: string) {
    await this.page.getByLabel(''Size'').selectOption(size);
  }

  async getPrice() {
    return await this.page.locator(''.price'').textContent();
  }
}

// pages/cart.page.ts
export class CartPage {
  constructor(private page: Page) {}

  async goto() {
    await this.page.goto(''https://example.com/cart'');
  }

  async proceedToCheckout() {
    await this.page.getByRole(''button'', { name: ''Checkout'' }).click();
    return new CheckoutPage(this.page);
  }

  async getTotal() {
    return await this.page.locator(''.cart-total'').textContent();
  }

  async removeItem(productName: string) {
    await this.page
      .locator(''.cart-item'')
      .filter({ hasText: productName })
      .getByRole(''button'', { name: ''Remove'' })
      .click();
  }
}

// tests/shopping.spec.ts
import { test, expect } from ''@playwright/test'';
import { ProductListPage } from ''../pages/product-list.page'';

test(''complete shopping flow'', async ({ page }) => {
  const productsPage = new ProductListPage(page);

  // Browse products
  await productsPage.goto();
  await productsPage.searchProduct(''shoes'');
  const count = await productsPage.getProductCount();
  expect(count).toBeGreaterThan(0);

  // View product detail
  const detailPage = await productsPage.selectProduct(''Running Shoes'');
  await detailPage.selectSize(''42'');
  const price = await detailPage.getPrice();
  await detailPage.addToCart();

  // Go to cart
  const cartPage = new CartPage(page);
  await cartPage.goto();
  const total = await cartPage.getTotal();
  expect(total).toContain(price);

  // Checkout
  const checkoutPage = await cartPage.proceedToCheckout();
  // ... continue flow
});
```

## Best Practices

### 1. One Page = One Class

```typescript
// ✅ Good: Each page has its own class
export class HomePage { }
export class LoginPage { }
export class DashboardPage { }

// ❌ Bad: Everything in one file
export class AllPages { }
```

### 2. Keep Locators in Page Objects

```typescript
// ✅ Good: Locators in page object
export class LoginPage {
  readonly emailInput = this.page.getByLabel(''Email'');
}

// ❌ Bad: Locators in test
test(''login'', async ({ page }) => {
  await page.getByLabel(''Email'').fill(''...'');
});
```

### 3. Return New Pages

```typescript
// ✅ Good: Return next page
async login(email: string, password: string) {
  // ... login logic
  return new DashboardPage(this.page);
}

// Usage
const dashboard = await loginPage.login(''...'', ''...'');
await dashboard.doSomething();
```

### 4. Use Descriptive Method Names

```typescript
// ✅ Good
async loginAsAdmin() { }
async selectProductByName(name: string) { }
async proceedToCheckout() { }

// ❌ Bad
async doLogin() { }
async select(name: string) { }
async next() { }
```


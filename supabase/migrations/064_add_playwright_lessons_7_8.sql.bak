  E'# Fixtures, Hooks & Test Configuration

## Understanding Fixtures

**Fixtures** provide a fixed baseline for tests. Playwright gives you built-in fixtures like `page`, `browser`, and `context`.

### Built-in Fixtures

```typescript
import { test } from ''@playwright/test'';

test(''example'', async ({ page, context, browser, browserName }) => {
  // page: Page object
  // context: Browser context
  // browser: Browser instance
  // browserName: ''chromium'', ''firefox'', or ''webkit''
});
```

## Custom Fixtures

Create reusable test setup with custom fixtures.

### Basic Custom Fixture

```typescript
// fixtures/auth.fixture.ts
import { test as base } from ''@playwright/test'';

export const test = base.extend({
  authenticatedPage: async ({ page }, use) => {
    // Setup: Login
    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(''user@example.com'');
    await page.getByLabel(''Password'').fill(''password123'');
    await page.getByRole(''button'', { name: ''Sign In'' }).click();
    await page.waitForURL(''**/dashboard'');

    // Use fixture in test
    await use(page);

    // Teardown (optional)
    await page.getByRole(''button'', { name: ''Logout'' }).click();
  },
});

// tests/dashboard.spec.ts
import { test } from ''../fixtures/auth.fixture'';
import { expect } from ''@playwright/test'';

test(''view dashboard'', async ({ authenticatedPage }) => {
  await expect(authenticatedPage.getByText(''Welcome'')).toBeVisible();
});
```

### Fixture with Options

```typescript
type TestFixtures = {
  loggedInUser: {
    email: string;
    role: ''admin'' | ''user'';
  };
};

export const test = base.extend<TestFixtures>({
  loggedInUser: async ({ page }, use) => {
    const email = ''user@example.com'';
    const role = ''user'';

    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(email);
    await page.getByLabel(''Password'').fill(''password'');
    await page.getByRole(''button'', { name: ''Sign In'' }).click();

    await use({ email, role });
  },
});

// Usage
test(''check user info'', async ({ loggedInUser }) => {
  expect(loggedInUser.email).toBe(''user@example.com'');
  expect(loggedInUser.role).toBe(''user'');
});
```

### Page Object Fixture

```typescript
import { LoginPage } from ''../pages/login.page'';
import { DashboardPage } from ''../pages/dashboard.page'';

type PageFixtures = {
  loginPage: LoginPage;
  dashboardPage: DashboardPage;
};

export const test = base.extend<PageFixtures>({
  loginPage: async ({ page }, use) => {
    await use(new LoginPage(page));
  },

  dashboardPage: async ({ page }, use) => {
    await use(new DashboardPage(page));
  },
});

// Usage
test(''login and navigate'', async ({ loginPage, dashboardPage }) => {
  await loginPage.goto();
  await loginPage.login(''user@example.com'', ''password'');
  await dashboardPage.verifyLoaded();
});
```

## Test Hooks

Hooks run code before/after tests automatically.

### beforeEach & afterEach

```typescript
import { test, expect } from ''@playwright/test'';

test.beforeEach(async ({ page }) => {
  // Runs before EACH test
  await page.goto(''https://example.com'');
  console.log(''Test started'');
});

test.afterEach(async ({ page }) => {
  // Runs after EACH test
  console.log(''Test completed'');
  await page.screenshot({ path: ''screenshot.png'' });
});

test(''test 1'', async ({ page }) => {
  // beforeEach runs first
  await expect(page).toHaveTitle(/Example/);
  // afterEach runs after
});

test(''test 2'', async ({ page }) => {
  // beforeEach runs again
  await page.click(''button'');
  // afterEach runs after
});
```

### beforeAll & afterAll

```typescript
test.beforeAll(async () => {
  // Runs ONCE before all tests in this file
  console.log(''Setting up test suite'');
  // Example: Create test database, start server
});

test.afterAll(async () => {
  // Runs ONCE after all tests in this file
  console.log(''Cleaning up test suite'');
  // Example: Delete test data, stop server
});

test(''test 1'', async ({ page }) => { });
test(''test 2'', async ({ page }) => { });
// beforeAll runs once, then all tests, then afterAll runs once
```

### Hooks with describe

```typescript
test.describe(''Login Flow'', () => {
  test.beforeEach(async ({ page }) => {
    await page.goto(''https://example.com/login'');
  });

  test(''successful login'', async ({ page }) => {
    // page is already on login page
  });

  test(''failed login'', async ({ page }) => {
    // page is already on login page
  });
});

test.describe(''Dashboard'', () => {
  test.beforeEach(async ({ page }) => {
    // Different setup for dashboard tests
    await page.goto(''https://example.com/dashboard'');
  });

  test(''view stats'', async ({ page }) => { });
});
```

## Test Organization with describe

### Grouping Tests

```typescript
test.describe(''User Authentication'', () => {
  test(''login with valid credentials'', async ({ page }) => { });
  test(''login with invalid credentials'', async ({ page }) => { });
  test(''password reset flow'', async ({ page }) => { });
});

test.describe(''Shopping Cart'', () => {
  test(''add item to cart'', async ({ page }) => { });
  test(''remove item from cart'', async ({ page }) => { });
  test(''update quantity'', async ({ page }) => { });
});
```

### Nested describe

```typescript
test.describe(''E-Commerce'', () => {
  test.describe(''Cart Operations'', () => {
    test(''add item'', async ({ page }) => { });
    test(''remove item'', async ({ page }) => { });
  });

  test.describe(''Checkout'', () => {
    test(''enter shipping info'', async ({ page }) => { });
    test(''complete payment'', async ({ page }) => { });
  });
});
```

## Test Annotations

### Skip Tests

```typescript
test.skip(''not ready yet'', async ({ page }) => {
  // This test won''t run
});

// Skip conditionally
test(''mobile only'', async ({ page, isMobile }) => {
  test.skip(!isMobile, ''Desktop only test'');
  // Test content
});
```

### Focus on Specific Tests

```typescript
test.only(''run only this'', async ({ page }) => {
  // Only this test will run
});

test(''this won''t run'', async ({ page }) => { });
test(''this won''t run either'', async ({ page }) => { });
```

### Mark as Failing

```typescript
test.fail(''known bug'', async ({ page }) => {
  // Test is expected to fail
  // Won''t fail the test suite
});
```

### Slow Tests

```typescript
test(''slow operation'', async ({ page }) => {
  test.slow(); // Triples the timeout
  await page.waitForTimeout(60000);
});
```

## playwright.config.ts Deep Dive

Complete configuration file explained:

```typescript
import { defineConfig, devices } from ''@playwright/test'';

export default defineConfig({
  // Test directory
  testDir: ''./tests'',

  // Timeout settings
  timeout: 30 * 1000, // 30 seconds per test
  expect: {
    timeout: 5000, // 5 seconds for assertions
  },

  // Retry failed tests
  retries: process.env.CI ? 2 : 0, // Retry on CI only

  // Parallel execution
  workers: process.env.CI ? 1 : undefined, // Serial on CI, parallel locally
  fullyParallel: true, // Run tests in parallel

  // Reporter
  reporter: [
    [''html''],
    [''list''],
    process.env.CI ? [''github''] : [''line''],
  ],

  // Global setup/teardown
  globalSetup: require.resolve(''./global-setup''),
  globalTeardown: require.resolve(''./global-teardown''),

  // Shared settings for all tests
  use: {
    // Base URL
    baseURL: ''http://localhost:3000'',

    // Browser options
    headless: true,
    viewport: { width: 1280, height: 720 },
    screenshot: ''only-on-failure'',
    video: ''retain-on-failure'',
    trace: ''on-first-retry'',

    // Timeouts
    actionTimeout: 10000,
    navigationTimeout: 30000,

    // Locale & timezone
    locale: ''en-US'',
    timezoneId: ''America/New_York'',

    // Geolocation
    geolocation: { longitude: 12.492507, latitude: 41.889938 },
    permissions: [''geolocation''],
  },

  // Test multiple browsers
  projects: [
    {
      name: ''chromium'',
      use: { ...devices[''Desktop Chrome''] },
    },
    {
      name: ''firefox'',
      use: { ...devices[''Desktop Firefox''] },
    },
    {
      name: ''webkit'',
      use: { ...devices[''Desktop Safari''] },
    },
    {
      name: ''Mobile Chrome'',
      use: { ...devices[''Pixel 5''] },
    },
    {
      name: ''Mobile Safari'',
      use: { ...devices[''iPhone 12''] },
    },
  ],

  // Web server (optional)
  webServer: {
    command: ''npm run start'',
    url: ''http://localhost:3000'',
    reuseExistingServer: !process.env.CI,
    timeout: 120 * 1000,
  },
});
```

### Environment-based Config

```typescript
// Load environment variables
import dotenv from ''dotenv'';
dotenv.config();

export default defineConfig({
  use: {
    baseURL: process.env.BASE_URL || ''http://localhost:3000'',
  },
});
```

### Project-specific Config

```typescript
projects: [
  {
    name: ''logged-out'',
    use: { ...devices[''Desktop Chrome''] },
  },
  {
    name: ''logged-in'',
    use: {
      ...devices[''Desktop Chrome''],
      storageState: ''auth.json'', // Reuse authenticated state
    },
    dependencies: [''setup''], // Run setup project first
  },
],
```


  E'# Data-Driven Testing & Parameterization

## What is Data-Driven Testing?

**Data-driven testing** means running the same test with different input data. Instead of writing separate tests for each scenario, you write one test and feed it different data.

### Without Data-Driven (Repetitive)

```typescript
test(''login with user 1'', async ({ page }) => {
  await page.goto(''https://example.com/login'');
  await page.getByLabel(''Email'').fill(''user1@example.com'');
  await page.getByLabel(''Password'').fill(''password1'');
  // ... assertions
});

test(''login with user 2'', async ({ page }) => {
  await page.goto(''https://example.com/login'');
  await page.getByLabel(''Email'').fill(''user2@example.com'');
  await page.getByLabel(''Password'').fill(''password2'');
  // ... same assertions
});

// Repeating same code! 😰
```

### With Data-Driven (Clean)

```typescript
const users = [
  { email: ''user1@example.com'', password: ''password1'' },
  { email: ''user2@example.com'', password: ''password2'' },
  { email: ''user3@example.com'', password: ''password3'' },
];

for (const user of users) {
  test(`login with ${user.email}`, async ({ page }) => {
    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(user.email);
    await page.getByLabel(''Password'').fill(user.password);
    // ... assertions
  });
}
```

## Using Arrays for Test Data

### Simple Array

```typescript
const searchTerms = [''Playwright'', ''Testing'', ''Automation'', ''TypeScript''];

for (const term of searchTerms) {
  test(`search for "${term}"`, async ({ page }) => {
    await page.goto(''https://example.com'');
    await page.getByPlaceholder(''Search'').fill(term);
    await page.keyboard.press(''Enter'');
    await expect(page.locator(''.results'')).toContainText(term);
  });
}
```

### Array of Objects

```typescript
const testCases = [
  { input: ''valid@email.com'', expected: true, description: ''valid email'' },
  { input: ''invalid-email'', expected: false, description: ''missing @'' },
  { input: ''@example.com'', expected: false, description: ''missing username'' },
  { input: ''user@'', expected: false, description: ''missing domain'' },
];

for (const testCase of testCases) {
  test(`email validation: ${testCase.description}`, async ({ page }) => {
    await page.goto(''https://example.com/signup'');
    await page.getByLabel(''Email'').fill(testCase.input);
    await page.getByLabel(''Email'').blur();

    if (testCase.expected) {
      await expect(page.locator(''.error'')).toBeHidden();
    } else {
      await expect(page.locator(''.error'')).toBeVisible();
    }
  });
}
```

## Loading Data from JSON

### Create Test Data File

```json
// test-data/users.json
{
  "validUsers": [
    {
      "email": "admin@example.com",
      "password": "Admin@123",
      "role": "admin"
    },
    {
      "email": "user@example.com",
      "password": "User@123",
      "role": "user"
    }
  ],
  "invalidUsers": [
    {
      "email": "invalid@example.com",
      "password": "wrong",
      "expectedError": "Invalid credentials"
    }
  ]
}
```

### Load JSON in Tests

```typescript
import userData from ''../test-data/users.json'';

// Test with valid users
for (const user of userData.validUsers) {
  test(`login as ${user.role}`, async ({ page }) => {
    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(user.email);
    await page.getByLabel(''Password'').fill(user.password);
    await page.getByRole(''button'', { name: ''Sign In'' }).click();

    await expect(page).toHaveURL(/.*dashboard.*/);
    await expect(page.getByText(`Role: ${user.role}`)).toBeVisible();
  });
}

// Test with invalid users
for (const user of userData.invalidUsers) {
  test(`invalid login: ${user.email}`, async ({ page }) => {
    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(user.email);
    await page.getByLabel(''Password'').fill(user.password);
    await page.getByRole(''button'', { name: ''Sign In'' }).click();

    await expect(page.locator(''.error'')).toHaveText(user.expectedError);
  });
}
```

## Loading Data from CSV

### CSV File

```csv
# test-data/products.csv
name,price,category,inStock
Laptop,999,Electronics,true
Phone,599,Electronics,true
Desk,299,Furniture,false
Chair,199,Furniture,true
```

### Parse CSV in Tests

```typescript
import fs from ''fs'';
import { parse } from ''csv-parse/sync'';

// Read and parse CSV
const csvContent = fs.readFileSync(''test-data/products.csv'', ''utf-8'');
const products = parse(csvContent, {
  columns: true,
  skip_empty_lines: true,
  cast: true, // Auto-convert types
});

for (const product of products) {
  test(`add ${product.name} to cart`, async ({ page }) => {
    await page.goto(''https://example.com/products'');

    // Search for product
    await page.getByPlaceholder(''Search'').fill(product.name);
    await page.keyboard.press(''Enter'');

    // Verify price
    await expect(page.locator(''.price'')).toHaveText(`$${product.price}`);

    // Check stock status
    if (product.inStock) {
      await page.getByRole(''button'', { name: ''Add to Cart'' }).click();
      await expect(page.locator(''.cart-count'')).toHaveText(''1'');
    } else {
      await expect(page.getByText(''Out of Stock'')).toBeVisible();
    }
  });
}
```

## Parameterized Fixtures

Create fixtures that accept parameters for dynamic test setup.

### Basic Parameterized Fixture

```typescript
import { test as base } from ''@playwright/test'';

type Role = ''admin'' | ''user'' | ''guest'';

type TestOptions = {
  userRole: Role;
};

const test = base.extend<TestOptions>({
  userRole: [''user'', { option: true }], // Default value

  page: async ({ page, userRole }, use) => {
    // Login based on role
    const credentials = {
      admin: { email: ''admin@example.com'', password: ''admin123'' },
      user: { email: ''user@example.com'', password: ''user123'' },
      guest: { email: ''guest@example.com'', password: ''guest123'' },
    };

    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(credentials[userRole].email);
    await page.getByLabel(''Password'').fill(credentials[userRole].password);
    await page.getByRole(''button'', { name: ''Sign In'' }).click();

    await use(page);
  },
});

// Usage with different roles
test(''admin can delete users'', async ({ page }) => {
  test.use({ userRole: ''admin'' });
  await expect(page.getByRole(''button'', { name: ''Delete User'' })).toBeVisible();
});

test(''regular user cannot delete users'', async ({ page }) => {
  test.use({ userRole: ''user'' });
  await expect(page.getByRole(''button'', { name: ''Delete User'' })).toBeHidden();
});
```

### Multiple Parameter Combinations

```typescript
const browsers = [''chromium'', ''firefox'', ''webkit''] as const;
const viewports = [
  { width: 1920, height: 1080, name: ''Desktop'' },
  { width: 375, height: 667, name: ''Mobile'' },
  { width: 768, height: 1024, name: ''Tablet'' },
];

for (const browser of browsers) {
  for (const viewport of viewports) {
    test(`responsive test on ${browser} - ${viewport.name}`, async ({ page }) => {
      await page.setViewportSize({ width: viewport.width, height: viewport.height });
      await page.goto(''https://example.com'');

      // Verify responsive design
      if (viewport.width < 768) {
        await expect(page.locator(''.mobile-menu'')).toBeVisible();
      } else {
        await expect(page.locator(''.desktop-menu'')).toBeVisible();
      }
    });
  }
}
```

## Advanced: API Test Data

Generate test data from API:

```typescript
import { test, expect } from ''@playwright/test'';

let testUsers: any[] = [];

test.beforeAll(async ({ request }) => {
  // Fetch test data from API
  const response = await request.get(''https://api.example.com/test-users'');
  testUsers = await response.json();
});

for (let i = 0; i < 5; i++) {
  test(`test with user ${i}`, async ({ page }) => {
    const user = testUsers[i];
    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(user.email);
    await page.getByLabel(''Password'').fill(user.password);
    await page.getByRole(''button'', { name: ''Sign In'' }).click();
    await expect(page).toHaveURL(/.*dashboard.*/);
  });
}
```

## Complete Example: E-Commerce Testing

```typescript
import { test, expect } from ''@playwright/test'';
import testData from ''../test-data/checkout.json'';

interface CheckoutData {
  user: {
    email: string;
    password: string;
  };
  shipping: {
    firstName: string;
    lastName: string;
    address: string;
    city: string;
    zip: string;
  };
  payment: {
    cardNumber: string;
    expiry: string;
    cvv: string;
  };
}

for (const scenario of testData.scenarios as CheckoutData[]) {
  test(`complete checkout: ${scenario.user.email}`, async ({ page }) => {
    // Login
    await page.goto(''https://example.com/login'');
    await page.getByLabel(''Email'').fill(scenario.user.email);
    await page.getByLabel(''Password'').fill(scenario.user.password);
    await page.getByRole(''button'', { name: ''Sign In'' }).click();

    // Add product to cart (simplified)
    await page.goto(''https://example.com/products/laptop'');
    await page.getByRole(''button'', { name: ''Add to Cart'' }).click();

    // Checkout - Shipping
    await page.goto(''https://example.com/checkout'');
    await page.getByLabel(''First Name'').fill(scenario.shipping.firstName);
    await page.getByLabel(''Last Name'').fill(scenario.shipping.lastName);
    await page.getByLabel(''Address'').fill(scenario.shipping.address);
    await page.getByLabel(''City'').fill(scenario.shipping.city);
    await page.getByLabel(''ZIP Code'').fill(scenario.shipping.zip);
    await page.getByRole(''button'', { name: ''Continue'' }).click();

    // Payment
    await page.getByLabel(''Card Number'').fill(scenario.payment.cardNumber);
    await page.getByLabel(''Expiry'').fill(scenario.payment.expiry);
    await page.getByLabel(''CVV'').fill(scenario.payment.cvv);
    await page.getByRole(''button'', { name: ''Place Order'' }).click();

    // Verify success
    await expect(page.getByText(''Order Confirmed'')).toBeVisible();
  });
}
```

## Best Practices

### 1. Organize Test Data

```
test-data/
  ├── users.json
  ├── products.csv
  ├── checkout-scenarios.json
  └── api-endpoints.json
```

### 2. Use Descriptive Test Names

```typescript
// ✅ Good
test(`login with ${user.role} role`, async ({ page }) => {});

// ❌ Bad
test(''test 1'', async ({ page }) => {});
```

### 3. Keep Data Separate from Logic

```typescript
// ✅ Good: Data in separate file
import users from ''./users.json'';

// ❌ Bad: Data in test file
const users = [/* ... */];
```

### 4. Validate Data Structure

```typescript
import { z } from ''zod'';

const UserSchema = z.object({
  email: z.string().email(),
  password: z.string().min(8),
  role: z.enum([''admin'', ''user'']),
});

// Validate before using
for (const user of users) {
  const validated = UserSchema.parse(user);
  test(`login as ${validated.role}`, async ({ page }) => {
    // Use validated data
  });
}
```


      'easy'
    );
  END IF;

  -- =====================================================
  -- LESSON 2 QUIZ QUESTIONS (8 questions)
  -- =====================================================

  IF lesson2_id IS NOT NULL THEN
    -- Question 1
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      code_example,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'What does the async keyword do in a Playwright test?',
      'multiple_choice',
      '{"A": "Makes tests run faster", "B": "Allows using await for asynchronous operations", "C": "Creates multiple test instances", "D": "Enables parallel execution"}'::jsonb,
      'B',
      'The async keyword allows you to use await to wait for promises to resolve, which is necessary for Playwright's asynchronous operations like page.goto() or page.click().',
      'test('example', async ({ page }) => { await page.goto('...'); });',
      1,
      'easy'
    );

    -- Question 2
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'What is the recommended locator strategy in Playwright?',
      'multiple_choice',
      '{"A": "CSS selectors", "B": "XPath", "C": "getByRole", "D": "jQuery"}'::jsonb,
      'C',
      'getByRole is recommended because it matches accessibility roles (like how screen readers work), making tests resilient to UI changes and ensuring your app is accessible.',
      2,
      'easy'
    );

    -- Question 3
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'What does the page fixture provide in a test?',
      'multiple_choice',
      '{"A": "A fresh browser page for each test", "B": "The test configuration", "C": "Test results", "D": "Browser console logs"}'::jsonb,
      'A',
      'The page fixture is automatically created by Playwright and provides an isolated browser page for each test. It's automatically cleaned up after the test completes.',
      3,
      'medium'
    );

    -- Question 4
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      code_example,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'Which assertion checks if an element is visible on the page?',
      'multiple_choice',
      '{"A": "toExist()", "B": "toBeVisible()", "C": "toAppear()", "D": "toDisplay()"}'::jsonb,
      'B',
      'toBeVisible() checks that an element is both attached to the DOM and visible (not hidden by CSS display:none or visibility:hidden).',
      'await expect(page.locator('h1')).toBeVisible();',
      4,
      'easy'
    );

    -- Question 5
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'What is the purpose of test.beforeEach()?',
      'multiple_choice',
      '{"A": "Run once before all tests", "B": "Run before each test in the describe block", "C": "Run after each test", "D": "Run only on test failure"}'::jsonb,
      'B',
      'beforeEach() runs before every single test in the describe block. It's useful for common setup like logging in or navigating to a specific page.',
      5,
      'medium'
    );

    -- Question 6
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      code_example,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'How do you click a button by its accessible name?',
      'multiple_choice',
      '{"A": "page.click('button')", "B": "page.getByRole('button', { name: 'Submit' }).click()", "C": "page.locator('button[name=\"Submit\"]').click()", "D": "page.find('Submit').click()"}'::jsonb,
      'B',
      'getByRole with the name option finds buttons by their accessible name (text content or aria-label). This is the most reliable and accessible way to locate elements.',
      'await page.getByRole('button', { name: 'Submit' }).click();',
      6,
      'easy'
    );

    -- Question 7
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'What does the fill() method do?',
      'multiple_choice',
      '{"A": "Only types text without clearing", "B": "Clears the input first, then types the text", "C": "Selects all text in the input", "D": "Validates the input value"}'::jsonb,
      'B',
      'fill() clears the existing value first, then fills in the new value. This ensures the input has exactly the text you want. Use type() if you don't want to clear first.',
      7,
      'medium'
    );

    -- Question 8
    INSERT INTO playwright_quiz_questions (
      lesson_id,
      question_text,
      question_type,
      options,
      correct_answer,
      explanation,
      order_index,
      difficulty
    ) VALUES (
      lesson2_id,
      'What does the AAA pattern stand for in testing?',
      'multiple_choice',
      '{"A": "Act, Assert, Analyze", "B": "Arrange, Act, Assert", "C": "Allocate, Apply, Assess", "D": "Access, Action, Approve"}'::jsonb,
      'B',
      'AAA stands for Arrange (setup), Act (perform action), Assert (verify outcome). This is a standard test structure pattern that makes tests clear and easy to understand.',
      8,
      'easy'
    );
  END IF;

  RAISE NOTICE 'Playwright quiz questions inserted successfully';
  RAISE NOTICE 'Lesson 1: % questions', (SELECT COUNT(*) FROM playwright_quiz_questions WHERE lesson_id = lesson1_id);
  RAISE NOTICE 'Lesson 2: % questions', (SELECT COUNT(*) FROM playwright_quiz_questions WHERE lesson_id = lesson2_id);
END $$;

-- =====================================================
-- VERIFICATION & SUMMARY
-- =====================================================

DO $$
DECLARE
  path_count INTEGER;
  lesson_count INTEGER;
  quiz_question_count INTEGER;
BEGIN
  SELECT COUNT(*) INTO path_count
  FROM ai_learning_paths
  WHERE id = 'f8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c';

  SELECT COUNT(*) INTO lesson_count
  FROM ai_learning_lessons
  WHERE learning_path_id = 'f8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c';

  SELECT COUNT(*) INTO quiz_question_count
  FROM playwright_quiz_questions;

  RAISE NOTICE '========================================';
  RAISE NOTICE 'Playwright Learning Module - Migration Complete';
  RAISE NOTICE '========================================';
  RAISE NOTICE 'Learning paths created: %', path_count;
  RAISE NOTICE 'Lessons created: %', lesson_count;
  RAISE NOTICE 'Quiz questions created: %', quiz_question_count;
  RAISE NOTICE 'Quiz tables: playwright_quiz_questions, playwright_quiz_attempts, playwright_quiz_sessions';
  RAISE NOTICE 'RLS policies: Enabled and configured';
  RAISE NOTICE '========================================';
  RAISE NOTICE 'Next step: Update lib/quiz/quiz-service.ts mapping';
  RAISE NOTICE 'Add: 'f8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c': 'playwright'';
  RAISE NOTICE '========================================';
END $$;

-- =====================================================
-- MIGRATION COMPLETE
-- =====================================================

COMMENT ON TABLE playwright_quiz_questions IS 'Quiz questions for Playwright learning module';
COMMENT ON TABLE playwright_quiz_attempts IS 'Individual question attempts for Playwright quizzes';
COMMENT ON TABLE playwright_quiz_sessions IS 'Overall quiz session results for Playwright lessons';

-- =====================================================
-- STEP 2: CREATE QUIZ TABLES
-- =====================================================

-- Quiz Questions Table
CREATE TABLE IF NOT EXISTS playwright_quiz_questions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  lesson_id UUID REFERENCES ai_learning_lessons(id) ON DELETE CASCADE,
  question_text TEXT NOT NULL,
  question_type TEXT CHECK (question_type IN ('multiple_choice', 'true_false')),
  options JSONB,
  correct_answer TEXT NOT NULL,
  explanation TEXT NOT NULL,
  code_example TEXT,
  order_index INTEGER NOT NULL,
  difficulty TEXT CHECK (difficulty IN ('easy', 'medium', 'hard')),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Quiz Attempts Table
CREATE TABLE IF NOT EXISTS playwright_quiz_attempts (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
  lesson_id UUID REFERENCES ai_learning_lessons(id) ON DELETE CASCADE,
  quiz_question_id UUID REFERENCES playwright_quiz_questions(id) ON DELETE CASCADE,
  user_answer TEXT,
  is_correct BOOLEAN NOT NULL,
  attempt_number INTEGER DEFAULT 1,
  time_taken_seconds INTEGER,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Quiz Sessions Table
CREATE TABLE IF NOT EXISTS playwright_quiz_sessions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
  lesson_id UUID REFERENCES ai_learning_lessons(id) ON DELETE CASCADE,
  total_questions INTEGER NOT NULL,
  correct_answers INTEGER NOT NULL,
  score_percentage INTEGER NOT NULL,
  passed BOOLEAN NOT NULL,
  time_taken_seconds INTEGER,
  completed_at TIMESTAMPTZ DEFAULT NOW()
);

-- Create Indexes
CREATE INDEX IF NOT EXISTS idx_playwright_quiz_questions_lesson ON playwright_quiz_questions(lesson_id);
CREATE INDEX IF NOT EXISTS idx_playwright_quiz_attempts_user ON playwright_quiz_attempts(user_id);
CREATE INDEX IF NOT EXISTS idx_playwright_quiz_attempts_lesson ON playwright_quiz_attempts(lesson_id);
CREATE INDEX IF NOT EXISTS idx_playwright_quiz_sessions_user ON playwright_quiz_sessions(user_id);
CREATE INDEX IF NOT EXISTS idx_playwright_quiz_sessions_lesson ON playwright_quiz_sessions(lesson_id);

-- Enable RLS
ALTER TABLE playwright_quiz_questions ENABLE ROW LEVEL SECURITY;
ALTER TABLE playwright_quiz_attempts ENABLE ROW LEVEL SECURITY;
ALTER TABLE playwright_quiz_sessions ENABLE ROW LEVEL SECURITY;

-- RLS Policies for Questions (public read)
DROP POLICY IF EXISTS "Anyone can read quiz questions" ON playwright_quiz_questions;
CREATE POLICY "Anyone can read quiz questions"
  ON playwright_quiz_questions FOR SELECT
  USING (true);

-- RLS Policies for Attempts (user-specific)
DROP POLICY IF EXISTS "Users can insert their own attempts" ON playwright_quiz_attempts;
CREATE POLICY "Users can insert their own attempts"
  ON playwright_quiz_attempts FOR INSERT
  WITH CHECK (auth.uid() = user_id);

DROP POLICY IF EXISTS "Users can view their own attempts" ON playwright_quiz_attempts;
CREATE POLICY "Users can view their own attempts"
  ON playwright_quiz_attempts FOR SELECT
  USING (auth.uid() = user_id);

-- RLS Policies for Sessions (user-specific)
DROP POLICY IF EXISTS "Users can insert their own sessions" ON playwright_quiz_sessions;
CREATE POLICY "Users can insert their own sessions"
  ON playwright_quiz_sessions FOR INSERT
  WITH CHECK (auth.uid() = user_id);

DROP POLICY IF EXISTS "Users can view their own sessions" ON playwright_quiz_sessions;
CREATE POLICY "Users can view their own sessions"
  ON playwright_quiz_sessions FOR SELECT
  USING (auth.uid() = user_id);

